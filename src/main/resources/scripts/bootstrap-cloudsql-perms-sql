-- Run as superuser once during bootstrap
-- Responsible for: roles, IAM users, privileges

-- 1. Create Postgres roles
CREATE ROLE readonly_role NOLOGIN;
CREATE ROLE readwrite_role NOLOGIN;

-- 2. Grant schema usage to roles
GRANT USAGE ON SCHEMA public TO readonly_role;
GRANT USAGE ON SCHEMA public TO readwrite_role;

-- 3. Grant table privileges to roles
GRANT SELECT ON ALL TABLES IN SCHEMA public TO readonly_role;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO readwrite_role;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO readwrite_role;

-- 4. Assign roles to users (ensure the IAM user below is already created in the SQL instance)
GRANT readwrite_role TO "ref-gsa@project-9627b595-2a5e-4fc1-9f1.iam";